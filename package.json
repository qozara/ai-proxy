{
  "name": "@qozara/ai-proxy-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@qozara/ai-proxy-worker",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "check": "tsc --build --clean && tsc --build",
    "users": "tsc -b apps/worker && node apps/worker/scripts/manage-users.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
