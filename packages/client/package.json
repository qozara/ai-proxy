{
  "name": "@qozara/ai-client",
  "version": "1.0.0",
  "description": "Isomorphic AI client SDK for Qozara ecosystem with polymorphic fallback and KMS envelope encryption support",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qozara/ai-proxy.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  }
}
