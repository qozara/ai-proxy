# 32-byte Edge KMS Secret for AES-256-GCM envelope encryption
# Generate via: openssl rand -base64 32 | cut -c1-32
KMS_SECRET=supersecretkmskeyexactly32bytes!

# Qozara Intelligence Dedicated Google Gemini API Key
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyFakeKeyForLocalDevelopmentOnly

# Upstash Redis for Sliding Window Rate Limiting & Mode 1A Allowlist (required in production)
KV_REST_API_URL=https://fake-redis.upstash.io
KV_REST_API_TOKEN=fake-token

# Mode 1A Registered-User Admin Secret (at least 16 chars; safely rotatable without affecting Redis hashes)
# Generate via: openssl rand -base64 32
ADMIN_SECRET=replace-with-strong-admin-secret-at-least-16-chars

# Optional static allowlist (comma-separated emails or 64-char SHA-256/HMAC-SHA256 digests)
ALLOWED_USER_EMAILS=

# Optional secret HMAC-SHA256 pepper for Redis allowlist hashes (protects hashes even if Redis is leaked)
# Keep independent from ADMIN_SECRET and KMS_SECRET
ALLOWLIST_PEPPER=

# Optional comma-separated Google OAuth Client IDs allowed for Qozara Intelligence tokens
ALLOWED_GOOGLE_CLIENT_IDS=

# Max failed Google token validations per IP per 60s before isolate 429 flood shield engages
AUTH_FAILURE_LIMIT_REQUESTS=15

# Quota & Rate Limits
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW=1 d
GLOBAL_RATE_LIMIT_REQUESTS=500
GLOBAL_RATE_LIMIT_WINDOW=1 d
BYOK_BURST_LIMIT_REQUESTS=60
BYOK_BURST_LIMIT_WINDOW=1 m

# CLI User Management Target (optional override; defaults to https://ai.qozara.org)
AI_PROXY_URL=http://localhost:8787

# Model Defaults
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_AI_MODEL=llama3.2
